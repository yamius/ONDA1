# ONDA analytics MCP — server-side only. NEVER expose any of these to a client.
# Every value is read at request time; nothing is bundled or returned by a tool.

# --- Gate ---------------------------------------------------------------------
# Shared secret for the /api/mcp endpoint. REQUIRED: with it unset the endpoint
# refuses every request with 503 not_configured. An ungated gate is an open gate,
# and behind this one sit several sets of production credentials.
MCP_AUTH_TOKEN=

# --- GA4 (funnel_review) ------------------------------------------------------
# Numeric property id, e.g. 123456789 (NOT the G-XXXX measurement id).
GA4_PROPERTY_ID=
# Service-account JSON, single line. Grant it Viewer on the GA4 property.
GA4_SERVICE_ACCOUNT_JSON=

# --- App Store Connect (installs_review: organic sources) ---------------------
ASC_KEY_ID=
ASC_ISSUER_ID=
# Contents of the .p8 file. Newlines may be written as \n.
ASC_PRIVATE_KEY=
# App Store app id. Defaults to 6755912529 (ONDA Life) when unset; needed for the
# Analytics Reports (organic source breakdown), not for sales reports.
ASC_APP_ID=
# Sales-report vendor number (App Store Connect > Payments and Financial Reports).
ASC_VENDOR_NUMBER=

# --- Tenjin (installs_review: paid attribution) -------------------------------
TENJIN_API_KEY=

# --- RevenueCat (revenue_review) ----------------------------------------------
# SECRET key from the RevenueCat dashboard, needs charts_metrics:*:read.
# NOT the App Store Connect key named "RevenueCat" (4DY9BHU2H5) - that one is how
# RevenueCat reads Apple, the opposite direction.
REVENUECAT_API_KEY=
# Project id, e.g. proj1ab2c3d4 (RevenueCat dashboard > Project settings).
REVENUECAT_PROJECT_ID=

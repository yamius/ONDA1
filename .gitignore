.env.production

# Android keystore files (NEVER commit these!)
*.keystore
*.jks
*.pem
KEYSTORE_INFO.md

# Android build outputs
android-webview/app/build/
android-webview/app/src/main/assets/
android-webview/.gradle/
android-webview/local.properties

# Log files with potential secrets
attached_assets/*.txt
attached_assets/*.log

# Bot: topics already used for generation (local state)
scripts/used_topics.txt
.tmp/

# Local-only state for build scripts (IndexNow seen-URLs cache, GSC service
# account credentials, etc.). Never commit — secrets and per-machine state.
landing/.cache/

# Build artifacts from landing/scripts/optimize-images.mjs.
# Source PNGs and the 480w/768w hero WebP variants are committed (they're
# referenced as <link rel=preload> from index.html and need to exist on
# first build). Everything else is regenerated on every npm run build —
# Replit deploy runs the same script, so these don't need to ship in git.
landing/public/**/*.avif
landing/public/**/*-640w.webp

# Supabase CLI local cache — regenerated on every CLI run, never commit
supabase/.temp/

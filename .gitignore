yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.vite-react-ssg-temp
*.local

.vscode/*
!.vscode/extensions.json

# Claude Code local/per-user config (permissions, worktrees, launch)
.claude/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env

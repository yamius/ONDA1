# Copy to .env.local or .env.production as needed.
# See .assistant/ENV_AND_BUILD.md for usage.

# Unlock all parts (no progress check). Use in dev or for builds where all parts must be open.
# VITE_UNLOCK_ALL_PARTS=true

# Bake the internal-traffic marker into the build: when 'true', the app reports
# GA4 user property internal=true from the FIRST event (no hidden 7-tap needed),
# so test/reinstall traffic never pollutes the d1 cohort. CI sets this per build
# (see ios-deploy.yml: internal on non-main branches). Leave unset for release.
# VITE_INTERNAL_BUILD=true

# --- Sentry source map upload (optional, production build only) ---
# Token: https://onda-y0.sentry.io/settings/account/api/auth-tokens/
# Scopes needed: project:releases, project:write, org:read
# SENTRY_AUTH_TOKEN=sntryu_...
# SENTRY_PROJECT=capacitor
# SENTRY_RELEASE=onda-life@1.7.1

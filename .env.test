# Test environment — loaded by Vitest in test mode.
# Stub values: src/lib/supabase.ts throws if VITE_SUPABASE_* are empty,
# which previously made any test that transitively imports it fail to
# load. No real backend is hit in tests — these just satisfy the guard.
VITE_SUPABASE_URL=https://stub-test.supabase.co
VITE_SUPABASE_ANON_KEY=stub-anon-key-for-tests
VITE_UNLOCK_ALL_PARTS=true

# Fastfile for ONDA iOS App
# This file automates building and deploying iOS app to TestFlight

default_platform(:ios)

platform :ios do
  before_all do
    # DISABLED: update_fastlane was causing issues with team_id
    # update_fastlane
    
    # Setup App Store Connect API Key for authentication
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
      # Read key content from file
      key_path = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      if key_path && File.exist?(key_path)
        key_content = File.read(key_path)
        puts "API Key file exists, size: #{key_content.length} bytes"
        puts "Key lines count: #{key_content.lines.count}"
        
        app_store_connect_api_key(
          key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
          issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
          key_content: key_content,
          in_house: false
        )
      else
        UI.user_error!("API Key file not found at: #{key_path}")
      end
    end
  end

  desc "Build iOS app"
  lane :build do
    # NOTE: npm install, npm run build, and npx cap sync ios are already done
    # in GitHub Actions workflow with proper environment variables.
    # Do NOT run them here again or Supabase env vars will be missing!
    
    # Auto-increment build number based on timestamp for unique builds
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: Time.now.strftime("%Y%m%d%H%M")
    )
    
    # Get actual profile names from match ENV variables (handles suffixes automatically)
    app_profile = ENV["sigh_com.onda-life.ios_appstore_profile-name"] || "match AppStore com.onda-life.ios"
    watch_profile = ENV["sigh_com.onda-life.ios.watchkitapp_appstore_profile-name"] || "match AppStore com.onda-life.ios.watchkitapp"
    
    UI.message("Using iOS profile: #{app_profile}")
    UI.message("Using watchOS profile: #{watch_profile}")
    
    # Configure code signing for App target
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      targets: ["App"],
      team_id: ENV['FASTLANE_TEAM_ID'],
      profile_name: app_profile,
      code_sign_identity: "Apple Distribution"
    )
    
    # Configure code signing for watchOS target
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      targets: ["watchkitapp Watch App"],
      team_id: ENV['FASTLANE_TEAM_ID'],
      profile_name: watch_profile,
      code_sign_identity: "Apple Distribution"
    )
    
    # Build the app with watchOS
    # IMPORTANT: Do NOT use -sdk iphoneos as it overrides watchOS SDK settings!
    # Let Xcode use the correct SDK for each target automatically
    gym(
      scheme: "App",
      workspace: "ios/App/App.xcworkspace",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "ONDA.ipa",
      clean: true,
      skip_build_archive: false,
      build_path: "./build/archive",
      archive_path: "./build/archive/App.xcarchive",
      xcargs: "DEVELOPMENT_TEAM=#{ENV['FASTLANE_TEAM_ID']} CODE_SIGN_STYLE=Manual ONLY_ACTIVE_ARCH=NO",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.onda-life.ios" => app_profile,
          "com.onda-life.ios.watchkitapp" => watch_profile
        }
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    # Setup code signing with Match using API Key (no password needed)
    
    # Clean up auth value (remove any trailing newlines/spaces that break git header)
    git_auth = ENV['MATCH_GIT_BASIC_AUTHORIZATION']&.strip
    UI.message("Match git_basic_authorization length: #{git_auth&.length || 0}")
    
    # Match for iOS app
    match(
      type: "appstore",
      app_identifier: "com.onda-life.ios",
      team_id: ENV['FASTLANE_TEAM_ID'],
      readonly: false,
      force: true,
      force_for_new_devices: true,
      git_basic_authorization: git_auth,
      api_key_path: nil,
      keychain_name: ENV['CI'] ? "build.keychain" : nil,
      keychain_password: ENV['CI'] ? "" : nil
    )
    
    # Match for watchOS app
    match(
      type: "appstore",
      app_identifier: "com.onda-life.ios.watchkitapp",
      team_id: ENV['FASTLANE_TEAM_ID'],
      readonly: false,
      force: true,
      force_for_new_devices: true,
      git_basic_authorization: git_auth,
      api_key_path: nil,
      keychain_name: ENV['CI'] ? "build.keychain" : nil,
      keychain_password: ENV['CI'] ? "" : nil
    )
    
    # Build the app
    build
    
    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      notify_external_testers: false,
      # Set by the workflow's "Release guard" step: internal / non-main builds
      # are stamped "INTERNAL — DO NOT SUBMIT TO APP STORE" in What to Test.
      changelog: ENV['ONDA_TESTFLIGHT_CHANGELOG'] || "Build #{Time.now.strftime('%Y-%m-%d %H:%M')}"
    )
  end

  desc "Release to App Store"
  lane :release do
    # Guard: App Store uploads only from main and never from an internal build.
    branch = (ENV['GITHUB_REF_NAME'] || sh("git rev-parse --abbrev-ref HEAD").strip)
    UI.user_error!("release lane: App Store builds only from main (got #{branch})") unless branch == "main"
    UI.user_error!("release lane: VITE_INTERNAL_BUILD=true cannot go to the App Store") if ENV['VITE_INTERNAL_BUILD'].to_s == "true"
    # Setup code signing
    match(
      type: "appstore",
      readonly: true
    )
    
    # Build the app
    build
    
    # Upload to App Store
    upload_to_app_store(
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false
    )
  end

  desc "Setup Match for code signing"
  lane :setup_match do
    match(
      type: "development",
      readonly: false
    )
    
    match(
      type: "appstore",
      readonly: false
    )
  end

  after_all do |lane|
    notification(
      title: "ONDA iOS",
      message: "Successfully completed '#{lane}' lane!"
    ) unless ENV["CI"]
  end

  error do |lane, exception|
    notification(
      title: "ONDA iOS Error",
      message: "Failed in '#{lane}' lane: #{exception.message}"
    ) unless ENV["CI"]
  end
end

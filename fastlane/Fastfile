# Fastfile for ONDA iOS App
# This file automates building and deploying iOS app to TestFlight

default_platform(:ios)

platform :ios do
  before_all do
    update_fastlane
    
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
      key_path = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      if key_path && File.exist?(key_path)
        key_content = File.read(key_path)
        puts "API Key file exists, size: #{key_content.length} bytes"
        
        app_store_connect_api_key(
          key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
          issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
          key_content: key_content,
          in_house: false
        )
      else
        UI.user_error!("API Key file not found at: #{key_path}")
      end
    end
  end

  desc "Build iOS app"
  lane :build do
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: Time.now.strftime("%Y%m%d%H%M")
    )
    
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      targets: ["App"],
      team_id: ENV['FASTLANE_TEAM_ID'],
      profile_name: "match AppStore com.onda-life.ios",
      code_sign_identity: "Apple Distribution"
    )
    
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      targets: ["watchkitapp Watch App"],
      team_id: ENV['FASTLANE_TEAM_ID'],
      profile_name: "match AppStore com.onda-life.ios.watchkitapp",
      code_sign_identity: "Apple Distribution"
    )
    
    gym(
      scheme: "App",
      workspace: "ios/App/App.xcworkspace",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "ONDA.ipa",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM=#{ENV['FASTLANE_TEAM_ID']}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.onda-life.ios" => "match AppStore com.onda-life.ios",
          "com.onda-life.ios.watchkitapp" => "match AppStore com.onda-life.ios.watchkitapp"
        }
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    match(
      type: "appstore",
      app_identifier: "com.onda-life.ios",
      readonly: false,
      force: true,
      force_for_new_devices: true,
      api_key_path: nil,
      keychain_name: ENV['CI'] ? "build.keychain" : nil,
      keychain_password: ENV['CI'] ? "" : nil
    )
    
    match(
      type: "appstore",
      app_identifier: "com.onda-life.ios.watchkitapp",
      readonly: false,
      force: true,
      force_for_new_devices: true,
      api_key_path: nil,
      keychain_name: ENV['CI'] ? "build.keychain" : nil,
      keychain_password: ENV['CI'] ? "" : nil
    )
    
    build
    
    ENV["DELIVER_ALTOOL_ADDITIONAL_UPLOAD_PARAMETERS"] = "--use-old-altool"
    
    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      notify_external_testers: false,
      changelog: "Build #{Time.now.strftime('%Y-%m-%d %H:%M')}"
    )
  end

  desc "Release to App Store"
  lane :release do
    match(type: "appstore", readonly: true)
    build
    upload_to_app_store(
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false
    )
  end

  desc "Setup Match for code signing"
  lane :setup_match do
    match(type: "development", readonly: false)
    match(type: "appstore", readonly: false)
  end

  after_all do |lane|
    notification(title: "ONDA iOS", message: "Successfully completed '#{lane}' lane!")
  end

  error do |lane, exception|
    notification(title: "ONDA iOS Error", message: "Failed in '#{lane}' lane: #{exception.message}")
  end
end

# Matchfile for ONDA iOS App
git_url(ENV["MATCH_GIT_URL"] || "https://github.com/YOUR_USERNAME/certificates")
storage_mode("git")
type("appstore")

# App Identifiers (Bundle IDs) - iOS + watchOS
app_identifier(["com.onda-life.ios", "com.onda-life.ios.watchkitapp"])

username(ENV["FASTLANE_USER"] || "your-apple-id@example.com")
team_id(ENV["FASTLANE_TEAM_ID"])

# Use existing profiles without creating new ones
readonly(true)

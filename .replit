modules = ["nodejs-20", "web", "java-17", "java-graalvm22.3", "postgresql-16", "python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["nano", "unzip", "psmisc"]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "git pull origin main --ff-only || true && cd landing && rm -rf dist && npm install && npm run build"]
run = ["bash", "-c", "cd landing && npm install && node server.js"]
# Healthcheck: Replit checks / by default. Server has /health at top. In Deployments UI, set healthcheck path to /health if available.

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start-replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[userenv]

[userenv.shared]
VITE_UNLOCK_ALL_PARTS = "true"

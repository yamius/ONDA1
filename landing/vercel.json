{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.onda-life.com" }],
      "destination": "https://onda-life.com/$1",
      "statusCode": 301
    },
    {
      "source": "/part/i-resonate",
      "destination": "/part/i-am-vibration",
      "statusCode": 301
    },
    {
      "source": "/articles/system-analysis-cognitive-architecture",
      "destination": "/articles/cognitive-architecture-neural-throughput",
      "statusCode": 301
    },
    { "source": "/:lang(es|ru|uk)/reviews/:slug(amazfit-helio-ring|apple-watch-series-12|apple-watch-ultra-4|circular-ring-2|fitbit-air|garmin-fenix-8|luna-ring|oura-ring-5|ringconn-gen-3|ultrahuman-ring-pro)", "destination": "/reviews/:slug", "permanent": true },
    { "source": "/glossary/insular-cortex", "destination": "/glossary/insula", "permanent": true },
    { "source": "/:lang(es|ru|uk|zh|de|fr|it|nl|ja|pl|pt)/glossary/insular-cortex", "destination": "/:lang/glossary/insula", "permanent": true },
    { "source": "/articles/metabolic-redundancy-hybrid-power-architecture", "destination": "/articles/metabolic-flexibility-dual-fuel-system", "permanent": true },
    { "source": "/:lang(es|ru|uk|zh|de|fr|it|nl|ja|pl|pt)/articles/metabolic-redundancy-hybrid-power-architecture", "destination": "/:lang/articles/metabolic-flexibility-dual-fuel-system", "permanent": true },
    { "source": "/articles/dopamine-stacking-preventing-circuit-overload", "destination": "/articles/dopamine-architecture-mastering-desire", "permanent": true },
    { "source": "/:lang(es|ru|uk|zh|de|fr|it|nl|ja|pl|pt)/articles/dopamine-stacking-preventing-circuit-overload", "destination": "/:lang/articles/dopamine-architecture-mastering-desire", "permanent": true },
    { "source": "/articles/glymphatic-flush-clearing-neural-cache", "destination": "/articles/nightly-flush-glymphatic-neural-cache", "permanent": true },
    { "source": "/:lang(es|ru|uk|zh|de|fr|it|nl|ja|pl|pt)/articles/glymphatic-flush-clearing-neural-cache", "destination": "/:lang/articles/nightly-flush-glymphatic-neural-cache", "permanent": true },
    { "source": "/topics", "destination": "/articles", "permanent": true },
    { "source": "/topics/hrv", "destination": "/articles/topic/hrv-heart-rate", "permanent": true },
    { "source": "/topics/breathwork", "destination": "/articles/topic/breathing", "permanent": true },
    { "source": "/topics/circadian", "destination": "/articles/topic/sleep-body-clock", "permanent": true },
    { "source": "/topics/cognitive", "destination": "/articles/topic/brain-focus-aging", "permanent": true },
    { "source": "/topics/neuroplasticity", "destination": "/articles/topic/brain-focus-aging", "permanent": true },
    { "source": "/topics/dopamine", "destination": "/articles/topic/brain-focus-aging", "permanent": true },
    { "source": "/topics/metabolic", "destination": "/articles/topic/heart-fitness-metabolism", "permanent": true },
    { "source": "/topics/hormones", "destination": "/articles/topic/stress-vagus", "permanent": true },
    { "source": "/topics/longevity", "destination": "/articles/topic/lifestyle", "permanent": true },
    { "source": "/topics/spinal", "destination": "/articles/topic/lifestyle", "permanent": true },
    { "source": "/topics/:slug*", "destination": "/articles", "permanent": true },
    { "source": "/:lang(es|ru)/topics", "destination": "/:lang/articles", "permanent": true },
    { "source": "/:lang(es|ru)/topics/:slug*", "destination": "/:lang/articles", "permanent": true },
    { "source": "/p/mundi", "destination": "/decks/onda-pitch-mundi-x9k4.pdf", "statusCode": 302 },
    { "source": "/p/info", "destination": "/decks/onda-eurostar-framework-r3p8.pdf", "statusCode": 302 },
    { "source": "/p/radboud", "destination": "/decks/onda-radboud-donders-m4t7.pdf", "statusCode": 302 },
    { "source": "/p/tno", "destination": "/decks/onda-tno-eurostars-h2v6.pdf", "statusCode": 302 }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/get" },
    { "source": "/download", "destination": "/get" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://tagmanager.google.com https://connect.facebook.net https://www.redditstatic.com https://us.i.posthog.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://tagmanager.google.com; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://*.googletagmanager.com https://*.midjourney.com https://cdn.midjourney.com https://www.facebook.com https://alb.reddit.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://pixel-config.reddit.com https://alb.reddit.com https://www.facebook.com https://connect.facebook.net https://*.supabase.co https://us.i.posthog.com https://us-assets.i.posthog.com; media-src 'self' blob: https://*.supabase.co; frame-src https://www.googletagmanager.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; frame-ancestors *"
        }
      ]
    },
    {
      "source": "/_content/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/decks/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
